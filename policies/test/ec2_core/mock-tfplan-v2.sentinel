													"module.ec2-instance[0]",
												],
											},
										},
										"subnet_shuffle": {
											"expression": {
												"references": [
													"random_shuffle.subnet.result",
													"random_shuffle.subnet",
												],
											},
										},
									},
									"resources": [
										{
											"address": "random_shuffle.subnet",
											"expressions": {
												"input": {
													"references": [
														"data.aws_subnets.subnets.ids",
														"data.aws_subnets.subnets",
													],
												},
												"result_count": {
													"constant_value": 1,
												},
											},
											"mode":                "managed",
											"name":                "subnet",
											"provider_config_key": "ec2_instance:random",
											"schema_version":      0,
