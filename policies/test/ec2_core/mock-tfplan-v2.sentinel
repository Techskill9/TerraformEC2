								"description": "Set to true only if a custom bootstrap script is required",
							},
							"custom_bootstrap": {
								"default":     "",
								"description": "If bootstrap overide is enabled pass script as a string in this variable",
							},
							"instance_tier": {
								"default":     "app",
								"description": "Network tier to place the instances valid values are app, web, dat",
							},
							"instance_type": {
								"default":     "m5.large",
								"description": "Instance type for all instances built by this module",
							},
							"number_of_instances": {
								"default":     1,
								"description": "Integer number of instances to be created using the specifications descibed for this module",
							},
							"okta_asa_key": {
								"default":     "",
								"description": "Token to enroll instances in Okta ASA for remote access",
							},
							"os": {
								"description": "Select from approved operating systems RHEL8, RHEL7, Windows2019, Windows2016, Windows2019AD, Windows2016AD, or AZL2.",
