						"count.index",
					],
					"root_block_device": [
						"var.root_volume_size",
					],
					"subnet_id": [
						"random_shuffle.subnet.result[0]",
						"random_shuffle.subnet.result",
						"random_shuffle.subnet",
					],
					"tags": [
						"var.tags",
					],
