import "tfplan/v2" as tfplan

resources = filter tfplan.resource_changes as _, rc{
    rc.change.after contains "tags" and (rc.change.actions contains "create" or rc.change.actions is ["update"]) and (rc.change.after.tags != null)
}

security_groups = filter tfplan.resource_changes as _, rc{
    rc.type is "aws_security_group_rule" and (rc.change.actions contains "create" or rc.change.actions is ["update"]) and (rc.change.after.type == "ingress") and (rc.change.after.cidr_blocks != null)
}

instance = filter tfplan.resource_changes as _, rc{
    rc.type is "aws_instance" and (rc.change.actions contains "create" or rc.change.actions is ["update"])
}

required_ec2_tags = [
    "apms-id",
    "business-unit-n1",
    "business-unit-n2",
    "application-owner-id",
    "environment-id",
    "application-name",
    "it-technical-owner",
    "ops-exclude-patch",
    "Name",
]

disallowed_cidr_blocks =[
    "0.0.0.0/0",
]


no_open_ingress = rule {
    all security_groups as name, sg{
        all disallowed_cidr_blocks as _, db{
           print ("Ingress Check: ",name," ", sg.change.after.cidr_blocks," ", db) and
           sg.change.after.cidr_blocks not contains db
        }
    }

}

has_tags = rule {
    all resources as name, resource {
        all required_ec2_tags as _, rt{
            print("Tagging Check: ",name, " Tag Key: ",rt, " Value: ",resource.change.after.tags[rt]," ",(resource.change.after.tags contains rt)) and
            resource.change.after.tags contains rt
        }
    }
}

valid_apms_id = rule {
    all resources as name, resource{
    print("APMS-ID Check: ", name, resource.change.after.tags["apms-id"], resource.change.after.tags["apms-id"] matches "^(APMS-[0-9]{5}$)") and
    resource.change.after.tags["apms-id"] matches "^(APMS-[0-9]{5}$)"
    }
}

instance_naming = rule {
    all instance as name, resource{
    print ("Instance Naming Check: ",name, resource.change.after.tags["Name"], resource.change.after.tags["Name"] matches "^((W|X)(USVGA|JPTYO|DEFRA|SGSIN|IEDUB|USORG)([1-9]){5}(D|T|P)([1-9]){1,3}$)") and
    resource.change.after.tags["Name"] matches "^((W|X)(USVGA|JPTYO|DEFRA|SGSIN|IEDUB|USORG)([0-9]){5}(D|T|P)([0-9]){1,3}$)"
    }
}

main = rule {has_tags and instance_naming and no_open_ingress and valid_apms_id} else true