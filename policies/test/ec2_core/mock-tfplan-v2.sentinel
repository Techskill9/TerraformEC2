										"bootstrap_override": {
											"default": false,
										},
										"custom_bootstrap": {
											"default": "",
										},
										"instance_tier":       {},
										"instance_type":       {},
										"number_of_instances": {},
										"okta_asa_key": {
											"default": "",
										},
										"os": {},
