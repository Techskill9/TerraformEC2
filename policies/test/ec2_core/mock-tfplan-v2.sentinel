										},
										{
											"address": "data.aws_kms_alias.ebs_key",
											"expressions": {
												"name": {
													"constant_value": "alias/TEC-EBS",
												},
											},
											"mode":                "data",
											"name":                "ebs_key",
											"provider_config_key": "ec2_instance:aws",
											"schema_version":      0,
											"type":                "aws_kms_alias",
										},
										{
											"address": "data.aws_ssm_parameter.ami_id",
											"expressions": {
												"name": {
