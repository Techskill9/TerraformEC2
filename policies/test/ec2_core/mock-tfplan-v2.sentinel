													],
												},
											},
											"mode":                "data",
											"name":                "ami_id",
											"provider_config_key": "ec2_instance:aws",
											"schema_version":      0,
											"type":                "aws_ssm_parameter",
										},
										{
											"address": "data.aws_subnets.subnets",
											"expressions": {
												"filter": [
