	"module.takeda_ec2_instance_web.module.ec2_instance": {
		"data": {
			"aws_kms_alias": {
				"ebs_key": {
					"config": {
						"name": "alias/TEC-EBS",
					},
					"provisioners": null,
					"references": {
						"name": [],
					},
				},
			},
			"aws_ssm_parameter": {
				"ami_id": {
					"config":       {},
					"provisioners": null,
					"references": {
						"name": [
							"local.ami_location",
						],
					},
				},
			},
			"aws_subnets": {
				"subnets": {
					"config": {
						"filter": [
							{
								"name": "vpc-id",
							},
						],
					},
					"provisioners": null,
					"references": {
						"filter": [
							{
								"name": [],
