											"default": {
												"RHEL7":         "/tec/golden-ami/RHEL7/ami-id",
												"RHEL8":         "/tec/golden-ami/RHEL8/ami-id",
												"Windows2016":   "/tec/golden-ami/Windows2016/NonDomainJoined/ami-id",
												"Windows2016AD": "/tec/golden-ami/Windows2016/DomainJoined/ami-id",
												"Windows2019":   "/tec/golden-ami/Windows2019/NonDomainJoined/ami-id",
												"Windows2019AD": "/tec/golden-ami/Windows2019/DomainJoined/ami-id",
											},
										},
										"os-prfix": {
											"default": {
												"AZL2":        "X",
												"RHEL7":       "X",
												"RHEL8":       "X",
												"Windows2016": "W",
												"Windows2019": "W",
											},
										},
										"region": {
											"default": "us-east-1",
										},
										"region_code": {
											"default": {
												"ap-northeast-1": "JPTYO",
												"ap-southeast-1": "SGSIN",
												"eu-central-1":   "DEFRA",
												"eu-west-1":      "IEDUB",
												"us-east-1":      "USVGA",
												"us-west-2":      "USORG",
