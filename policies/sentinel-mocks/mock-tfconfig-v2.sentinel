module_calls = {
	"module.takeda_ec2_instance.module.ec2_instance:ec2-instance": {
		"config": {
			"ami": {
				"references": [
					"data.aws_ssm_parameter.ami_id.value",
					"data.aws_ssm_parameter.ami_id",
				],
			},
			"iam_instance_profile": {
				"constant_value": "TEC-EC2-SSM",
			},
			"instance_type": {
				"references": [
					"var.instance_type",
				],
			},
			"name": {
				"references": [
					"var.os-prfix",
					"var.os",
					"var.region_code",
					"var.region",
					"var.tags",
					"var.tags",
					"count.index",
