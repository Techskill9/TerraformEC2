											"type":                "aws_subnets",
										},
										{
											"address": "data.aws_vpc.vpc",
											"expressions": {
												"filter": [
													{
														"name": {
															"constant_value": "tag:Name",
														},
														"values": {
															"constant_value": [
																"*-shr-*",
															],
														},
													},
												],
											},
											"mode":                "data",
											"name":                "vpc",
											"provider_config_key": "ec2_instance:aws",
											"schema_version":      0,
											"type":                "aws_vpc",
										},
									],
